# ─────────────────────────────────────────────────
# Career Tracker — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables are prefixed with CT_ to avoid conflicts.
# ─────────────────────────────────────────────────

# LLM Provider (anthropic or openai)
CT_LLM_PROVIDER=anthropic
CT_ANTHROPIC_API_KEY=sk-ant-your-key-here
# CT_OPENAI_API_KEY=sk-your-key-here
CT_LLM_MODEL=claude-sonnet-4-20250514

# Telegram Notifications
CT_TELEGRAM_BOT_TOKEN=your-bot-token-here
CT_TELEGRAM_CHAT_ID=your-chat-id-here

# Matching Thresholds (0.0 – 1.0)
CT_MATCH_THRESHOLD_HIGH=0.80
CT_MATCH_THRESHOLD_LOW=0.35

# Seniority Filter (comma-separated)
# CT_TARGET_SENIORITY_LEVELS=["entry","junior","mid"]

# Email Notifications
CT_EMAIL_TO=palulaptop@gmail.com

# Scheduling
CT_SCHEDULE_INTERVAL_HOURS=1

# Fetch Settings
CT_FETCH_TIMEOUT_SECONDS=30
CT_FETCH_MAX_RETRIES=3
CT_DEFAULT_RATE_LIMIT_SECONDS=2.0

# Database
# CT_DB_PATH=data/career_tracker.db

# ─── Free Job API Keys ─────────────────────────────
# These are optional — the dashboard works without them.
# Sign up for free keys to boost job coverage.

# Adzuna (100 requests/day free)
# https://developer.adzuna.com/
# CT_ADZUNA_APP_ID=your-app-id
# CT_ADZUNA_API_KEY=your-api-key

# JSearch via RapidAPI (100 requests/month free)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# CT_JSEARCH_API_KEY=your-rapidapi-key

# The Muse (500 requests/hour, no key needed for basic)
# https://www.themuse.com/developers/api/v2
# CT_THEMUSE_API_KEY=optional-api-key

